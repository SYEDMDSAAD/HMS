# Copy this file to .env to override the defaults.
#   cp dashboard/.env.example dashboard/.env
#
# .env is gitignored. Every value here is read at build time, so it is baked
# into the bundle and visible to anyone using the app — never put a secret in it.
#
# Vite only exposes variables prefixed with VITE_.

# Base URL of the backend API, including the /api/v1 prefix.
# Omit this file entirely and the code falls back to http://localhost:4000/api/v1,
# which matches PORT=4000 in backend/config/config.env.example.
#
# This app runs on port 5174 (pinned in vite.config.js) and that origin must be
# listed as FRONTEND_URL_TWO in backend/config/config.env, or CORS will reject
# every request.
VITE_API_URL=http://localhost:4000/api/v1
