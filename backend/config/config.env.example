# Copy this file to config.env and fill in real values.
#   cp backend/config/config.env.example backend/config/config.env
#
# config.env is gitignored. Never commit real credentials.
# app.js exits on startup if MONGO_URI, JWT_SECRET_KEY, JWT_EXPIRES or PORT is missing.

PORT=4000

# MongoDB Atlas connection string. The database name is set to "HMS" in code.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Allowed browser origins for CORS. These must match the ports pinned in
# frontend/vite.config.js (5173) and dashboard/vite.config.js (5174).
FRONTEND_URL_ONE=http://localhost:5173
FRONTEND_URL_TWO=http://localhost:5174

# Generate a long random secret, e.g.  openssl rand -base64 48
JWT_SECRET_KEY=<long-random-string>
JWT_EXPIRES=7d

# Auth cookie lifetime in days.
COOKIE_EXPIRE=7

# Cloudinary — used for doctor avatar uploads.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
